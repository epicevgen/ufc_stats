<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ufcstats.backup.schedule</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/evgenijstolarov/Documents/JavaProjects/ufc_stats/scripts/backup-db.sh</string>
        <string>backup</string>
    </array>
    
    <!-- Ежедневно в 2:00 ночи (только если компьютер не спит) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    
    <!-- Запускать при подключении к сети (когда компьютер пробуждается) -->
    <key>RunAtLoad</key>
    <false/>
    
    <!-- Запускать при подключении дисков/сети (пробуждение) -->
    <key>StartOnMount</key>
    <true/>
    
    <!-- Логи -->
    <key>StandardOutPath</key>
    <string>/Users/evgenijstolarov/Documents/JavaProjects/ufc_stats/backups/launchd-schedule.log</string>
    
    <key>StandardErrorPath</key>
    <string>/Users/evgenijstolarov/Documents/JavaProjects/ufc_stats/backups/launchd-schedule-error.log</string>
    
    <!-- Не запускать слишком часто (минимум час между запусками) -->
    <key>ThrottleInterval</key>
    <integer>3600</integer>
    
    <!-- Не перезапускать автоматически при ошибке -->
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>

