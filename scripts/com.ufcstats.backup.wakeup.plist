<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ufcstats.backup.wakeup</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd /Users/evgenijstolarov/Documents/JavaProjects/ufc_stats && /bin/bash scripts/backup-on-wake.sh</string>
    </array>
    
    <!-- Запускаем при подключении дисков/сети (происходит при пробуждении) -->
    <key>StartOnMount</key>
    <true/>
    
    <!-- НЕ запускаем при загрузке системы (только при пробуждении) -->
    <key>RunAtLoad</key>
    <false/>
    
    <key>StandardOutPath</key>
    <string>/Users/evgenijstolarov/Documents/JavaProjects/ufc_stats/backups/launchd-wakeup.log</string>
    
    <key>StandardErrorPath</key>
    <string>/Users/evgenijstolarov/Documents/JavaProjects/ufc_stats/backups/launchd-wakeup-error.log</string>
    
    <!-- Не запускать слишком часто (минимум час между запусками) -->
    <key>ThrottleInterval</key>
    <integer>3600</integer>
    
    <key>KeepAlive</key>
    <false/>
    
    <!-- Разрешения для работы с файловой системой -->
    <key>EnableGlobbing</key>
    <true/>
    
    <!-- Рабочая директория -->
    <key>WorkingDirectory</key>
    <string>/Users/evgenijstolarov/Documents/JavaProjects/ufc_stats</string>
    
    <!-- Переменные окружения -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>

