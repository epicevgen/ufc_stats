{
  "name": "ufc-stats-desktop",
  "version": "1.0.0",
  "description": "UFC Stats Desktop Application - Нативное приложение для отслеживания статистики боев UFC 5",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run start\" \"wait-on http://localhost:8080 && electron .\"",
    "start": "cd /Users/evgenijstolarov/Documents/JavaProjects/ufc_stats && ./gradlew bootRun",
    "build": "electron-builder",
    "build-mac": "electron-builder --mac",
    "build-win": "electron-builder --win",
    "build-linux": "electron-builder --linux",
    "dist": "npm run build",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "ufc",
    "stats",
    "desktop",
    "electron",
    "java",
    "spring-boot"
  ],
  "author": {
    "name": "Evgenij Stolarov",
    "email": "epicevgen@example.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.ufcstats.desktop",
    "productName": "UFC Stats",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "build/libs/*.jar",
      "data/**/*",
      "scripts/**/*"
    ],
    "extraResources": [
      {
        "from": "build/libs/",
        "to": "app/",
        "filter": ["*.jar"]
      },
      {
        "from": "data/",
        "to": "data/"
      },
      {
        "from": "scripts/",
        "to": "scripts/"
      }
    ],
    "mac": {
      "category": "public.app-category.sports",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
